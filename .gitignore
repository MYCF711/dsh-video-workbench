packages/dsh-editor/bin/
# 生成产物
outputs/
.frames/
*.mp4
*.webm
*.mov
*.wav
*.mp3

# ── DSH 运行时状态 ──────────────────────────────────────
.state/
.comfy-bridge/
*.corrupt-*

# ── 实测证据（体积大，需要时单独归档）───────────────────
# ⚠ 这些是「真机实测」的证据，有价值但不该占仓库体积。
#   完整现场见 <WORKSPACE>\_branch-archive\ 的带 docs 版本。
docs/evidence/
docs/预览/_shots/
*.png
*.jpg
*.jpeg
!docs/**/*.md

# ── 临时与备份 ──────────────────────────────────────────
.bak*
*.bak
*.bak-*
.tmp-scripts/
.test-cleanup-backup/
.probe-backup/
_verify6/
.usertest/
.src-backup-*/
.verify-restart/
_tmp*
_diag*

# ── 本机私有配置 ────────────────────────────────────────
# ★ 配置由设置页生成，含本机绝对路径，不该进仓库
config.json
*.local.md
AGENTS.local.md
dsh-tok.txt

# ── 编辑器 / OS ─────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
# ── 验收临时产物（每次运行都变，不该进仓库）────────────
# verify-no-pollution 的快照文件（288KB，每次跑都重写）
_snapshot-before.json
_snapshot-after.json
# ── 第三方产物：不进仓库（上游未声明许可协议，不能随仓库分发）──
# 剪辑台依赖 ArtCraft（@storyteller/ui-video-editor）的构建产物。
# 上游没有 license 声明 ⇒ 默认版权保留 ⇒ 不能再分发。
# 使用者自行生成：pwsh -NoProfile -File ./scripts/fetch-artcraft.ps1
packages/dsh-comfy-workbench-tab/src/editor/_artcraft-payload.js
packages/dsh-comfy-workbench-tab/src/editor/_artcraft-css.js
# 2026-10-25：改成按需下发后，真实产物放在这两个纯文本里（宿主侧读）。
# 它们不进 git 的理由同上。
packages/dsh-comfy-workbench-tab/src/editor/artcraft-payload.b64.txt
packages/dsh-comfy-workbench-tab/src/editor/artcraft-css.b64.txt
# ── 构建产物：不进仓库 ──
# lib/client.js 里【内联了 ArtCraft 的 base64 payload】，
# 而 ArtCraft 上游未声明许可协议（默认版权保留）。
# ⇒ 产物不能随仓库分发，使用者要自己构建：
#      cd packages/dsh-comfy-workbench-tab && npm install && node build.mjs
#      cd packages/dsh-editor && node build.mjs
packages/dsh-comfy-workbench-tab/lib/client.js


