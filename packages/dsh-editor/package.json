{
  "name": "dsh-editor",
  "version": "0.1.0",
  "description": "Rough-cut timeline workbench for DeepSeek Harness: multi-track timeline, per-clip regeneration, LLM tools, SSE live sync.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "bin": {
    "dsh-editor-install-ffmpeg": "./scripts/install-ffmpeg.mjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "install-ffmpeg": "node scripts/install-ffmpeg.mjs",
    "test": "node test/verify-all.mjs"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "video",
    "timeline",
    "ffmpeg"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
